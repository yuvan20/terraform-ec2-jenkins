pipeline {
    agent any

    parameters {
        choice(
            name: 'ACTION',
            choices: ['INIT', 'PLAN', 'APPLY', 'DESTROY'],
            description: 'Select Terraform Action'
        )
    }

    options {
        disableConcurrentBuilds()
        timestamps()
    }

    environment {
        TF_IN_AUTOMATION = "true"
    }

    stages {

        stage('Environment Check') {
            steps {
                dir('terraform-ec2-jenkins/terraform-ec2-jenkins') {
                    sh '''
                        echo "=============================="
                        echo "Current User:"
                        whoami

                        echo "=============================="
                        echo "Current Directory:"
                        pwd

                        echo "=============================="
                        echo "Terraform Version:"
                        terraform version

                        echo "=============================="
                        echo "AWS Identity:"
                        aws sts get-caller-identity

                        echo "=============================="
                        echo "Terraform Files:"
                        ls -ltr

                        echo "=============================="
                    '''
                }
            }
        }

        stage('Terraform Init') {
            steps {
                dir('terraform-ec2-jenkins/terraform-ec2-jenkins') {
                    sh 'terraform init'
                }
            }
        }

        stage('Terraform Validate') {
            steps {
                dir('terraform-ec2-jenkins/terraform-ec2-jenkins') {
                    sh 'terraform validate'
                }
            }
        }

        stage('Terraform Plan') {
            when {
                expression {
                    params.ACTION == 'PLAN' || params.ACTION == 'APPLY'
                }
            }

            steps {
                dir('terraform-ec2-jenkins/terraform-ec2-jenkins') {
                    sh 'terraform plan -lock-timeout=5m'
                }
            }
        }

        stage('Terraform Apply') {
            when {
                expression {
                    params.ACTION == 'APPLY'
                }
            }

            steps {
                dir('terraform-ec2-jenkins/terraform-ec2-jenkins') {
                    sh 'terraform apply -auto-approve -lock-timeout=5m'
                }
            }
        }

        stage('Terraform Destroy') {
            when {
                expression {
                    params.ACTION == 'DESTROY'
                }
            }

            steps {
                dir('terraform-ec2-jenkins/terraform-ec2-jenkins') {
                    sh 'terraform destroy -auto-approve -lock-timeout=5m'
                }
            }
        }

    }

    post {

        always {
            echo "Pipeline Finished"
        }

        success {
            echo "Terraform Job Completed Successfully"
        }

        failure {
            echo "Terraform Job Failed"
        }
    }
}
